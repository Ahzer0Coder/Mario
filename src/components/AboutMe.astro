---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-6" title="About me">
  <div class="flex flex-col gap-2">
    <p class="sr-only">
      Hi, I'm {SITE.author.firstName}, a software engineering from {SITE.location.countryName}. My primary
      tools of choice includes: C#, C++.
    </p>
    <div aria-hidden="true" class="text-sm font-light">
      <p class="text-sm font-light">
        Hi, I'm {SITE.author.firstName}, a Software engineering from {SITE.location.countryName}.
      </p>
      <br />
      My primary tools of choice includes:
      <ul class="list-disc list-inside">
        <li>C#</li>
        <li>C++</li>
      </ul>
      <p class="text-sm font-light mt-2">
       
      </p>
    </div>
    <p class="text-sm font-light">
    </p>
  </div>
</Card>
